.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test caches
.pytest_cache/

# Claude Code local state
.claude/worktrees/
.claude/settings.local.json

# Local virtualenv (name not covered by venv/.venv/env above)
floorplan_env/

# Generated/eval data — regenerable (synthesize.py) or local-only
floorplan3d/model/data/synthetic_vlm/
floorplan3d/model/data/synth_eval/
floorplan3d/model/data/synth_eval_heldout/
floorplan3d/model/data/mls_qualitative/
