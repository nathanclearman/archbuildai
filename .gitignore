# Local-only research files — never commit
/papercole/

# Stale nested clone at repo root (pending removal decision)
/archbuildai/

# Local debug / scratch outputs written into the model data dir during
# development — never commit (regenerable, machine-specific)
floorplan3d/model/data/debug_*
floorplan3d/model/data/last_*_output.json
floorplan3d/model/data/story_*_output.json
floorplan3d/model/data/test_output.*


# VLM runtime copied into the add-on by package.py (source of truth: floorplan3d/model/)
floorplan3d/blender_addon/vlm/
